	publisher = {The University of Texas at Austin},
	language = {English},
	abbrev_source_title = {Solid Freeform Fabr.: Proc. - Annu. Int. Solid Freeform Fabr. Symp. - Addit. Manuf. Conf., SFF},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; Conference name: 29th Annual International Solid Freeform Fabrication Symposium - An Additive Manufacturing Conference, SFF 2018; Conference date: 13 August 2018 through 15 August 2018; Conference code: 159687}
}

