	doi = {10.1364/JOSAA.549184},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002762442&doi=10.1364%2fJOSAA.549184&partnerID=40&md5=c5cae3008597496e546e368c432ac3b6},
	affiliations = {Japan Aerospace Exploration Agency (JAXA), 2-1-1 Sengen, Ibaraki, Tsukuba, Japan; University of Tokyo, Chiba, 266-0031, Japan},
	abstract = {This paper presents a polynomial-exponent model of the white-light interferogram and a direct fast Fourier transform-based algorithm for identifying it. The model covers a variety of envelope and fringe phase distributions due to the light source or dispersive material for a precise description and accurate analysis of real-world interferograms. Due to the mathematical structure of the model, i.e., differential equation modeling and the solution of integral equalities of it in the frequency domain, it leads to a two-step procedure: 1) parameter estimation of polynomial coefficients, and then 2) estimation of overall amplitude and phase. An envelope peak is obtained in 1) while independent of the fringe phase. If the reflection phase is unknown, it is obtained in 2) as a fringe phase at the envelope peak. If given, the position with this phase near the envelope peak obtained in 1) provides the interferogram center more accurately. On the estimation of higher-order parameters of interferogram, this study developed a method for calculating a dispersion parameter as a quadratic phase component of the interferogram. Various numerical analyses confirm the desired conditions and estimation accuracies close to the Cramér–Rao lower bound. © 2025 Optica Publishing Group under the terms of the Optica Open Access Publishing Agreement.},
	keywords = {Cramer-Rao bounds; Fast Fourier transforms; Frequency estimation; Interferometry; Polynomial approximation; Dispersive materials; Exponent models; Fast fourier; Interferograms; Light scanning; Modelling and identifications; Phase distribution; Source material; White light; White-light interferogram; algorithm; article; controlled study; dispersion; Fourier transform; white light; Frequency domain analysis},
