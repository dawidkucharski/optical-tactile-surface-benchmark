	affiliations = {School of Electronic and Optical Engineering, Nanjing University of Science and Technology, Jiangsu Province, Nanjing, China; School of Microelectronics (School of Integrated Circuits), Nanjing University of Science and Technology, Jiangsu Province, Nanjing, China; State key Laboratory of Extreme Environment Optoelectronic Dynamic Testing Technology and Instrument, Nanjing University of Science and Technology, Jiangsu Province, Nanjing, China; Jiangsu Key Laboratory of Visual Sensing and Intelligent Perception, Nanjing University of Science and Technology, Jiangsu Province, Nanjing, China},
	abstract = {Fringe projection profilometry (FPP) is a high-precision, non-contact optical 3D measurement technology widely used in smart manufacturing, such as quality control of precision components, biomedicine, and machine vision, such as robot sensing and object recognition. In FPP, the absolute phase of the measured object is necessary to be retrieved, however, traditional phase retrieval techniques require additional projection of fringe patterns, which can reduce the efficiency of real-time measurements. In this paper, a polarization-intensity composite coding method (PICM) for fast phase unwrapping under different reflectivity scenes is proposed. By combining polarization state and light intensity information, high- and low-frequency fringes are encoded into orthogonal polarization states, and only three frames of composite fringes need to be projected to complete dual-frequency phase unwrapping, greatly reducing the number of projections. At the same time, for scenes with weak polarization preservation, two frames of pure color patterns are projected to calibrate scene polarization parameters, effectively suppressing polarization channel crosstalk and ensuring the accuracy of phase unwrapping. Experimental results show that PICM achieves a standard deviation of 0.0588 mm for the standard metal block, and can accurately reconstruct the 3D shape of objects with different reflectivity, validating its effectiveness and robustness in actual 3D measurement applications. © 2025 Elsevier Ltd},
	author_keywords = {3-D measurement; Fringe projection profilometry; Phase unwrapping; Polarization-intensity composite coding},
	keywords = {Computer vision; Interferometry; Light polarization; Machine components; Object recognition; Profilometry; Projection systems; Quality control; Three dimensional computer graphics; 3-D measurement; Coding methods; Fringe projection profilometry; High-precision; Non-contact; Optical 3D-measurement; Phase-unwrapping; Polarization intensities; Polarization state; Polarization-intensity composite coding; Reflection},
	correspondence_address = {H. Yu; School of Electronic and Optical Engineering, Nanjing University of Science and Technology, Nanjing, Jiangsu Province, China; email: haotian_yu@njust.edu.cn},
