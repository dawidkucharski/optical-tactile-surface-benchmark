	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85197221154&doi=10.3390%2fma17122918&partnerID=40&md5=6ef30cbeeec82252ff12bfa7fef61d67},
	affiliations = {Faculty of Mechanical Engineering, Poznan University of Technology, ul. Piotrowo 3, Poznan, 60-965, Poland; Faculty of Mechanical Engineering and Aeronautics, Rzeszow University of Technology, Rzeszow, 35-959, Poland},
	abstract = {This work presents issues related to selected errors accompanying spatial measurements of surface roughness using contact profilometry. The influence of internal heat sources, such as engines or control electronics, on the thermal expansion of the drive responsible for the measurement probe’s movement in the X-axis direction was investigated. In terms of starting measurements on a thermally unstable device, the synchronization error of individual profile paths was 16.1 µm. Based on thermographic studies, the time required for full thermal stabilization of this drive was determined to be 6–12 h from when the device was turned on. It was demonstrated that thermal stabilization of the profilometer significantly reduced positioning errors of the measurement probe on the X-axis. Thermal stabilization time should be determined individually for a specific device variant. This research also determined how changes in the center of gravity caused by the measurement probe’s movement affected the overall rigidity of the profilometer structure and the leveling of the tested surface. Laser interferometry was used for this purpose. The determined vulnerability of the profilometer structure was 0.8 µm for a measurement section of 25 mm. Understanding the described relationships will reduce errors associated with conducting measurements and preparing equipment for tests. Additionally, it will enable the correct evaluation of surface geometry. © 2024 by the authors.},
	author_keywords = {center of gravity; elongation; interferometric measurement; interior thermal influences; surface asperities; thermal errors},
	keywords = {Errors; Probes; Profilometry; Spatial distribution; Stabilization; Surface roughness; Thermal expansion; Center of gravity; Interferometric measurement; Interior thermal influence; Measurements of; Profilometers; Spatial measurements; Surface asperities; Thermal error; Thermal influence; Thermal stabilization; Laser interferometry},
